  <script>

    async function enableBot(repoFullName, repoId) {

      const btn = document.getElementById('btn-' + repoId)
      const status = document.getElementById('status-' + repoId)

      // Loading State
      btn.disabled = true
      btn.textContent = '⏳ Setting up...'
      status.textContent = ''

      try {

        const res = await fetch('/repos/select', {
          method: 'POST',

          headers: {
            'Content-Type': 'application/json'
          },

          body: JSON.stringify({
            repoFullName
          })
        })

        const data = await res.json()

        if (data.success) {

          btn.textContent = '✅ Bot Enabled'
          btn.style.background = '#22c55e'

          status.textContent =
            'Webhook configured successfully! Open a PR and the bot will review it automatically.'

          status.style.color = '#22c55e'

        } else {

          btn.disabled = false
          btn.textContent = '🤖 Enable Bot'

          status.textContent =
            '❌ Error: ' + data.message

          status.style.color = '#ef4444'
        }

      } catch (err) {

        btn.disabled = false
        btn.textContent = '🤖 Enable Bot'

        status.textContent =
          '❌ Network error. Please try again.'

        status.style.color = '#ef4444'
      }
    }

  </script>

