<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — CodeReviewBot</title>
  <link rel="stylesheet" href="/public/style.css">
</head>
<body>

  <nav class="navbar">
    <div class="nav-brand">🤖 CodeReviewBot</div>

    <div class="nav-user">
      <img src="<%= user.avatarUrl %>" alt="avatar" class="avatar">

      <span><%= user.name || user.login %></span>

      <a href="/auth/logout" class="btn-logout">
        Logout
      </a>
    </div>
  </nav>

  <div class="dashboard">

    <div class="dash-header">
      <h1>Your Repositories</h1>
      <p>Enable the bot on any repository — webhook will be configured automatically.</p>
    </div>

    <div class="repos-grid">

      <% for(var i = 0; i < repos.length; i++) { %>

        <% var repo = repos[i] %>

        <div class="repo-card">

          <div class="repo-header">

            <div class="repo-name">

              <% if(repo.isPrivate) { %>
                🔒
              <% } else { %>
                📁
              <% } %>

              <a href="<%= repo.url %>" target="_blank">
                <%= repo.name %>
              </a>

            </div>

            <% if(repo.language) { %>
              <span class="lang-badge">
                <%= repo.language %>
              </span>
            <% } %>

          </div>

          <% if(repo.description) { %>
            <p class="repo-desc">
              <%= repo.description %>
            </p>
          <% } %>

          <div class="repo-footer">

            <span class="repo-updated">
              Updated: <%= repo.updatedAt %>
            </span>

            <button
              class="btn-enable"
              id="btn-<%= repo.id %>"
              onclick="enableBot('<%= repo.fullName %>', '<%= repo.id %>')"
            >
              🤖 Enable Bot
            </button>

          </div>

          <div
            class="status-msg"
            id="status-<%= repo.id %>"
          ></div>

        </div>

      <% } %>

    </div>
  </div>

  <script>

    async function enableBot(repoFullName, repoId) {

      var btn = document.getElementById('btn-' + repoId)

      var status = document.getElementById('status-' + repoId)

      btn.disabled = true
      btn.textContent = 'Setting up...'

      status.textContent = ''

      try {

        var res = await fetch('/repos/select', {
          method: 'POST',

          headers: {
            'Content-Type': 'application/json'
          },

          body: JSON.stringify({
            repoFullName: repoFullName
          })
        })

        var data = await res.json()

        if (data.success) {

          btn.textContent = 'Bot Enabled'

          btn.style.background = '#22c55e'

          status.textContent =
            'Webhook configured successfully! Open a PR and the bot will review it automatically.'

          status.style.color = '#22c55e'

        } else {

          btn.disabled = false

          btn.textContent = 'Enable Bot'

          status.textContent =
            'Error: ' + data.message

          status.style.color = '#ef4444'
        }

      } catch(err) {

        btn.disabled = false

        btn.textContent = 'Enable Bot'

        status.textContent =
          'Network error. Please try again.'

        status.style.color = '#ef4444'
      }
    }

  </script>

</body>
</html>
