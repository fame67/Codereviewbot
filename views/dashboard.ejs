<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — CodeReviewBot</title>
  <link rel="stylesheet" href="/public/style.css">
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar">
    <div class="nav-brand">🤖 CodeReviewBot</div>
    <div class="nav-user">
      <img src="<%= user.avatarUrl %>" alt="avatar" class="avatar">
      <span><%= user.name || user.login %></span>
      <a href="/auth/logout" class="btn-logout">Logout</a>
    </div>
  </nav>

  <div class="dashboard">

    <!-- Header -->
    <div class="dash-header">
      <h1>Tumhare Repos</h1>
      <p>Kisi bhi repo pe bot enable karo — webhook automatically set ho jaayega</p>
    </div>

    <!-- Webhook setup instructions -->
    <div class="setup-box">
      <h3>⚙️ Manual Setup (ek baar karna hai)</h3>
      <ol>
        <li>Jis repo pe bot chahiye uski <strong>Settings → Webhooks → Add webhook</strong> pe jao</li>
        <li>Payload URL: <code><%= baseUrl %>/webhook</code></li>
        <li>Content type: <code>application/json</code></li>
        <li>Secret: apna <code>GITHUB_WEBHOOK_SECRET</code> daalo</li>
        <li>Events: <strong>Pull requests</strong> select karo</li>
        <li>Save karo — bas! Bot active hai 🎉</li>
      </ol>
    </div>

    <!-- Repos list -->
    <div class="repos-grid">
      <% repos.forEach(repo => { %>
        <div class="repo-card">
          <div class="repo-header">
            <div class="repo-name">
              <% if (repo.isPrivate) { %>
                🔒
              <% } else { %>
                📁
              <% } %>
              <a href="<%= repo.url %>" target="_blank">
                <%= repo.name %>
              </a>
            </div>
            <% if (repo.language) { %>
              <span class="lang-badge"><%= repo.language %></span>
            <% } %>
          </div>

          <% if (repo.description) { %>
            <p class="repo-desc"><%= repo.description %></p>
          <% } %>

          <div class="repo-footer">
            <span class="repo-updated">Updated: <%= repo.updatedAt %></span>
            
              href="<%= repo.url %>/settings/hooks"
              target="_blank"
              class="btn-setup"
            >
              Webhook Setup →
            </a>
          </div>
        </div>
      <% }) %>
    </div>

  </div>

</body>
</html>