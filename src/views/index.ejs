<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CodeReviewBot — AI PR Reviewer</title>
  <link rel="stylesheet" href="/public/style.css">
</head>
<body>

  <div class="landing">

    <!-- Hero Section -->
    <div class="hero">
      <div class="bot-icon">🤖</div>
      <h1>CodeReviewBot</h1>
      <p class="tagline">
        As soon as a GitHub PR is opened, the AI automatically performs a code review.
It detects security vulnerabilities, bugs, performance issues, and other potential problems.
</p>

      <!-- Error message agar koi tha -->
      <% if (error) { %>
        <div class="error-banner">⚠️ <%= error %></div>
      <% } %>

      <!-- GitHub se Login -->
      <a href="/auth/login" class="btn-github">
        <svg height="20" viewBox="0 0 16 16" width="20" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38
          0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13
          -.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66
          .07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15
          -.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27
          .68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12
          .51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48
          0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
        </svg>
        Login with GitHub
      </a>

      
    </div>

    <!-- Features -->
    <div class="features">
      <div class="feature-card">
        <div class="feature-icon">🔒</div>
        <h3>Security Check</h3>
        <p>SQL injection, XSS, and hardcoded secrets are automatically detected.</p>

      </div>
      <div class="feature-card">
        <div class="feature-icon">⚡</div>
        <h3>Performance</h3>
<p>N+1 queries, memory leaks, and blocking operations are automatically identified.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🐛</div>
        <h3>Bug Detection</h3>
        <p>Logic errors, null pointers, unhandled edge cases</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">💬</div>
        <h3>Inline Comments</h3>
        <p>> Comments are added on the exact line — no confusion at all.
</p>
      </div>
    </div>

    <!-- How it works -->
    <div class="how-it-works">
      <h2>How it works?</h2>
      <div class="steps">
        <div class="step">
          <span class="step-num">1</span>
          <p>Login and select the repo </p>
        </div>
        <div class="step-arrow">→</div>
        <div class="step">
          <span class="step-num">2</span>
          <p>The webhook will be automatically configured in the Repo</p>
        </div>
        <div class="step-arrow">→</div>
        <div class="step">
          <span class="step-num">3</span>
          <p>Open any PR — the bot will automatically review it.</p>
        </div>
      </div>
    </div>

  </div>

</body>
</html>